<?xml version="1.0" encoding="utf-8"?>
<!-- The music video player. texture_view (not the default SurfaceView) so the
     video can shrink into the rounded mini-player card and animate between
     full screen and corner without the surface being torn down or ignoring
     the clip. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:shutter_background_color="@android:color/black" />
