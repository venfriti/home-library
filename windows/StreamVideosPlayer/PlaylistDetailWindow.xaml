<Window x:Class="StreamVideosPlayer.PlaylistDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Playlist" Height="640" Width="900" Icon="app.ico"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource SansFont}"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize">
    <!-- Same dark hand-drawn title bar as MainWindow, for the same reason:
         the default OS title bar is plain-themed and clashed hard with the
         dark content directly below it, reading as a jarring, unrelated
         window popping up rather than a dialog belonging to this app. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="36" Background="{StaticResource BgBrush}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Playlist" Foreground="{StaticResource MutedBrush}"
                           FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="14,0"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="&#xE8BB;" Style="{StaticResource TitleBarCloseButton}"
                        Click="CloseWindow_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </DockPanel>
        </Border>

        <DockPanel Margin="20">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14" LastChildFill="False">
                <TextBlock x:Name="TitleText" DockPanel.Dock="Left" Foreground="{StaticResource TextBrush}"
                           FontFamily="{StaticResource SerifFont}" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Delete Playlist" Style="{StaticResource PillButton}"
                        Click="DeletePlaylist_Click"/>
                <Button DockPanel.Dock="Right" Content="Remove Selected" Style="{StaticResource PillButton}"
                        Margin="0,0,8,0" Click="RemoveItem_Click"/>
            </DockPanel>
            <ListBox x:Name="ItemsList" Style="{StaticResource ScrollableCardListBox}"
                     MouseDoubleClick="ItemsList_MouseDoubleClick"/>
        </DockPanel>
    </DockPanel>
</Window>
