<Window x:Class="StreamVideosPlayer.AddToPlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to Playlist" Height="360" Width="320" Icon="app.ico" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#1e1e1e">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Add to an existing playlist" Foreground="White"
                   FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="Or create a new one" Foreground="White" Margin="0,0,0,4"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Create" Width="70" Margin="6,0,0,0"
                        Click="CreateButton_Click"/>
                <TextBox x:Name="NewPlaylistNameBox" KeyDown="NewPlaylistNameBox_KeyDown"/>
            </DockPanel>
        </StackPanel>
        <ListBox x:Name="PlaylistsList" Foreground="White" Background="#252526"
                 DisplayMemberPath="Name" MouseDoubleClick="PlaylistsList_MouseDoubleClick"/>
    </DockPanel>
</Window>
