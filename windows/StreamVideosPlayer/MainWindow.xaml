<Window x:Class="StreamVideosPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Stream" Height="860" Width="1500" Icon="app.ico"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource SansFont}"
        WindowStyle="None" ResizeMode="CanResize">
    <!-- Replaces the native OS title bar (plain-themed, clashed with the dark
         app content below it) with the hand-drawn strip below. WindowChrome
         keeps real Aero-snap/resize/drag behavior working, rather than
         reimplementing all of that by hand for a bare WindowStyle="None". -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <DockPanel>
        <Border DockPanel.Dock="Top" Height="36" Background="{StaticResource BgBrush}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Stream" Foreground="{StaticResource MutedBrush}"
                           FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="14,0"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="&#xE921;" Style="{StaticResource TitleBarButton}" Click="Minimize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="MaximizeRestoreButton" Content="&#xE922;" Style="{StaticResource TitleBarButton}"
                            Click="MaximizeRestore_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="&#xE8BB;" Style="{StaticResource TitleBarCloseButton}" Click="CloseWindow_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="#3a5f3a" Padding="10,6"
                Visibility="Collapsed">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="UpdateBannerText" DockPanel.Dock="Left" Foreground="White"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Download" Click="DownloadUpdate_Click"/>
                <Button DockPanel.Dock="Right" Content="Dismiss" Margin="0,0,6,0"
                        Click="DismissUpdate_Click"/>
            </DockPanel>
        </Border>

        <Grid>
            <!-- Browse layer -->
            <Grid x:Name="BrowseRoot">
                <Grid.Background>
                    <!-- The site washes the top of the page in a soft gold glow
                         (a radial gradient tinted with the site's gold accent
                         color) over the black background; this reproduces
                         that same atmosphere. -->
                    <RadialGradientBrush Center="0.5,0" RadiusX="0.9" RadiusY="0.6" GradientOrigin="0.5,0">
                        <GradientStop Color="#3D9A7D4A" Offset="0"/>
                        <GradientStop Color="#000A0A0A" Offset="1"/>
                    </RadialGradientBrush>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="28,18,28,10" LastChildFill="False">
                    <!-- Wordmark: matches the site's own .wordmark exactly,
                         "Stream" in bold serif, "Videos" in italic gold serif
                         (see .wordmark/.wordmark span in main.go's CSS). -->
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                               FontFamily="{StaticResource SerifFont}" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}">
                        <Run Text="Stream"/><Run Text="Videos" FontStyle="Italic" FontWeight="Normal"
                                                  Foreground="{StaticResource GoldBrush}"/>
                    </TextBlock>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="QueueButton" Style="{StaticResource IconButton}"
                                Click="ToggleQueueDrawer_Click" ToolTip="Queue">
                            <Path Data="{StaticResource IconQueue}" Fill="{StaticResource TextBrush}"
                                  Width="18" Height="18" Stretch="Uniform"/>
                        </Button>

                        <!-- Not on the web UI (it only has one catalog). This
                             app can also reach the LAN-only local library (see
                             GetLocalFilesAsync), so it needs a source switch
                             the site has no equivalent of: one alternating
                             toggle rather than two separate pills. -->
                        <Button x:Name="SourceToggleButton" Style="{StaticResource ToggleSwitchButton}"
                                Click="SourceToggle_Click" Margin="10,0,0,0" ToolTip="Switch between Online and Local">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSwap}" Width="12" Height="12"
                                      Fill="{StaticResource MutedBrush}" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock x:Name="SourceToggleText" Text="ONLINE"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="SearchToggleButton" Style="{StaticResource IconButton}"
                                Click="ToggleSearchOverlay_Click" Margin="6,0,0,0" ToolTip="Search">
                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource TextBrush}"
                                  Width="17" Height="17" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Scroll-spy jump list, mirroring #section-tags on the web:
                     built dynamically in code (RebuildSections), one pill per
                     section that actually has content, clicking scrolls the
                     page to it instead of switching a visible/hidden tab. -->
                <StackPanel x:Name="SectionTagsPanel" Grid.Row="1" Orientation="Horizontal"
                            Margin="28,0,28,12"/>

                <!-- Shown instead of the local catalog when GetLocalFilesAsync
                     fails, typically because this device isn't actually on
                     the same network as the server, which /local/files
                     requires (see localOnly in main.go). Never triggers a
                     silent auto-switch back to Online; that would be more
                     surprising than the error it replaces. -->
                <Border x:Name="LocalFailureBanner" Grid.Row="2" VerticalAlignment="Top" Background="#5a3a1e"
                        BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"
                        Padding="14,10" Margin="20,8,20,0" Visibility="Collapsed" Panel.ZIndex="5">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Foreground="White" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="520"
                                   Text="Not connected to your local network — Local browsing only works on the same network as the server."/>
                        <Button DockPanel.Dock="Right" Content="Switch to Online" Style="{StaticResource PillButton}"
                                Click="SwitchToOnlineFromBanner_Click"/>
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="MainScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              ScrollChanged="MainScroll_ScrollChanged">
                    <StackPanel x:Name="SectionsPanel" Margin="20,4,20,20"/>
                </ScrollViewer>
            </Grid>

            <!-- Search overlay: a full-window scrim with one large input,
                 matching the site's #search-overlay chrome, wired to the same
                 client-side title filter the old inline textbox used (not the
                 site's torrent-acquisition search behind the same button,
                 which is a LAN-only admin workflow, out of scope for a
                 viewing client). -->
            <Grid x:Name="SearchOverlay" Background="#EE0A0A0A" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Width="640" Margin="0,120,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                Click="ToggleSearchOverlay_Click">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextBrush}"
                                  Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                        <TextBox x:Name="SearchOverlayBox" Style="{StaticResource DarkTextBox}" FontSize="22"
                                 Padding="12" TextChanged="SearchBox_TextChanged"/>
                    </DockPanel>
                </StackPanel>
            </Grid>

            <!-- Queue drawer: slides in from the right rather than being a
                 top-level content tag, since it holds transient playback
                 state, not a content category, so it doesn't belong in the
                 section-tags row alongside Films/Series/etc. -->
            <Border x:Name="QueueDrawer" Background="{StaticResource Bg2Brush}" Width="360"
                    HorizontalAlignment="Right" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1,0,0,0" Visibility="Collapsed">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,16,16,8" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="UP NEXT" Foreground="{StaticResource TextBrush}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center"/>
                        <!-- The queue icon in the top bar toggles this drawer,
                             but that wasn't discoverable as a close action once
                             the drawer was open, so this is an explicit one. -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28"
                                Click="ToggleQueueDrawer_Click" ToolTip="Close">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource MutedBrush}"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource PillButton}"
                                Margin="0,0,8,0" Click="ClearQueue_Click"/>
                    </DockPanel>
                    <ListBox x:Name="QueueList" Style="{StaticResource ScrollableCardListBox}"
                             MouseDoubleClick="QueueList_MouseDoubleClick"/>
                </DockPanel>
            </Border>

            <!-- Player overlay: a dimming scrim over the whole window (so the
                 browse page and its gradient stay visible around the edges,
                 not covered edge-to-edge) with an inset panel holding the
                 actual player, closer to the web's modal than a full
                 takeover. -->
            <Grid x:Name="PlayerOverlay" Background="#D2000000" Visibility="Collapsed">
                <Border Margin="56" Background="Black" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Its own row, not overlaid on the video below: VideoView
                             hosts a native child window internally, which always
                             paints over pure-WPF siblings regardless of XAML/Z
                             order ("airspace"), so a button placed on top of it
                             never gets a click or even renders visibly. Also
                             deliberately not next to the play/pause button below,
                             so it isn't mistaken for a "previous" control. -->
                        <Border Grid.Row="0" Background="Black" Padding="6">
                            <Button HorizontalAlignment="Left" Style="{StaticResource IconButton}"
                                    Click="ClosePlayer_Click" ToolTip="Back to library">
                                <Path Data="{StaticResource IconBack}" Fill="{StaticResource TextBrush}"
                                      Width="20" Height="20" Stretch="Uniform"/>
                            </Button>
                        </Border>

                        <vlc:VideoView x:Name="Player" Grid.Row="1" Background="Black"/>

                        <Grid Grid.Row="2" Background="{StaticResource Bg2Brush}">
                            <StackPanel Margin="16,10">
                                <TextBlock x:Name="NowPlayingText" Foreground="{StaticResource TextBrush}"
                                           FontFamily="{StaticResource SansFont}" FontSize="13" Margin="0,0,0,6"/>
                                <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" Height="16"
                                        Thumb.DragStarted="PositionSlider_DragStarted"
                                        Thumb.DragCompleted="PositionSlider_DragCompleted"/>
                                <DockPanel Margin="0,8,0,0" LastChildFill="False">
                                    <Button DockPanel.Dock="Left" x:Name="PlayPauseButton"
                                            Style="{StaticResource IconButton}" Click="PlayPause_Click">
                                        <Path x:Name="PlayPauseIcon" Data="{StaticResource IconPause}"
                                              Fill="{StaticResource TextBrush}" Width="22" Height="22" Stretch="Uniform"/>
                                    </Button>
                                    <TextBlock DockPanel.Dock="Left" x:Name="TimeText" Foreground="{StaticResource MutedBrush}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               VerticalAlignment="Center" Margin="8,0,0,0" Text="00:00 / 00:00"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="VOL" Foreground="{StaticResource MutedBrush}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,0,8,0"/>
                                        <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="100"
                                                ValueChanged="VolumeSlider_ValueChanged"/>
                                    </StackPanel>

                                    <!-- Exposes libVLC's own track/rate/aspect control
                                         (this is real VLC underneath, not a browser
                                         <video> element, so all of this is available)
                                         rather than only play/pause/seek/volume. -->
                                    <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                            Click="ToggleSettingsPanel_Click" Margin="0,0,4,0" ToolTip="Audio, subtitles, speed, aspect">
                                        <TextBlock Text="⚙" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                                    </Button>
                                </DockPanel>
                            </StackPanel>

                            <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}"
                                   Placement="Top" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource BorderBrush2}"
                                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,8">
                                    <StackPanel Width="230">
                                        <TextBlock Text="AUDIO TRACK" Foreground="{StaticResource MutedBrush}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="AudioTrackCombo" Margin="0,0,0,10"
                                                  SelectionChanged="AudioTrackCombo_SelectionChanged"/>

                                        <TextBlock Text="SUBTITLES" Foreground="{StaticResource MutedBrush}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="SubtitleTrackCombo" Margin="0,0,0,10"
                                                  SelectionChanged="SubtitleTrackCombo_SelectionChanged"/>

                                        <TextBlock Text="SPEED" Foreground="{StaticResource MutedBrush}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="SpeedCombo" Margin="0,0,0,10"
                                                  SelectionChanged="SpeedCombo_SelectionChanged"/>

                                        <TextBlock Text="ASPECT RATIO" Foreground="{StaticResource MutedBrush}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="AspectCombo" SelectionChanged="AspectCombo_SelectionChanged"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
