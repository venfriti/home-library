<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StreamVideosPlayer</AssemblyName>
    <RootNamespace>StreamVideosPlayer</RootNamespace>
    <!-- Bump alongside data/windows_app_version.json on the server when
         cutting a new release; see ServerClient.GetLatestVersionAsync. -->
    <Version>1.0.0</Version>
    <Company>Venfriti</Company>
    <Authors>Venfriti</Authors>
    <Product>Stream</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official VideoLAN .NET bindings + native libVLC binaries. libVLC embeds
         its own libav-based decoders, so AC3/EAC3/DTS/TrueHD/FLAC audio and any
         video codec the server already reports via ffprobe just decode, with no
         browser codec allowlist, no MSE, and no per-file remuxing needed. -->
    <PackageReference Include="LibVLCSharp" Version="3.8.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.20" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also embedded as a WPF resource so Window.Icon="app.ico" resolves at
         runtime (ApplicationIcon above only sets the .exe's own icon). -->
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
