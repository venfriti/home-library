<Application x:Class="StreamVideosPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette: mirrors the web UI's :root custom properties in main.go
                 (search for the "0a0a0a" background color there) so the native
                 app reads as the same product rather than a generic WPF app. -->
            <SolidColorBrush x:Key="BgBrush" Color="#0A0A0A"/>
            <SolidColorBrush x:Key="Bg2Brush" Color="#141414"/>
            <SolidColorBrush x:Key="Bg3Brush" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="BorderBrush2" Color="#2A2A2A"/>
            <SolidColorBrush x:Key="GoldBrush" Color="#9A7D4A"/>
            <SolidColorBrush x:Key="GoldTextBrush" Color="#C9A765"/>
            <SolidColorBrush x:Key="TextBrush" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#666666"/>
            <SolidColorBrush x:Key="PlayBrush" Color="#D9282D"/>
            <SolidColorBrush x:Key="PlayLitBrush" Color="#EF3237"/>

            <!-- Implicit (no x:Key) ScrollBar style: applies to every
                 scrollbar in the app automatically, replacing the default
                 light Windows chrome (which stood out badly against the dark
                 theme) with a thin, minimal thumb matching the palette. -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10"/>
                <Setter Property="MinWidth" Value="10"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Width="10">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                                      Background="Transparent" BorderThickness="0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                                      Background="Transparent" BorderThickness="0"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBd" Background="{StaticResource BorderBrush2}"
                                                            CornerRadius="4" Margin="2,0"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBd" Property="Background"
                                                                    Value="{StaticResource GoldBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark ContextMenu/MenuItem: the default is a light OS-themed
                 popup, which stood out the same way the scrollbar did. -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4"/>
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg3Brush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The site loads DM Sans / JetBrains Mono / Libre Baskerville from
                 Google Fonts. Those aren't installed system-wide on Windows, so
                 this uses the same fallback fonts the site's own CSS font-stack
                 names (Consolas for mono, Georgia for the serif no-art titles;
                 Segoe UI is Windows' own DM-Sans-equivalent geometric sans). -->
            <FontFamily x:Key="SansFont">Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">Consolas</FontFamily>
            <FontFamily x:Key="SerifFont">Georgia</FontFamily>

            <!-- Same Material-style icon paths the web UI's inline <svg> icons use
                 (see MINI_PLAY_ICON/MINI_PAUSE_ICON and #topbar-back in main.go). -->
            <Geometry x:Key="IconPlay">M8 5v14l11-7z</Geometry>
            <Geometry x:Key="IconPause">M6 19h4V5H6v14zm8-14v14h4V5h-4z</Geometry>
            <Geometry x:Key="IconBack">M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z</Geometry>
            <Geometry x:Key="IconPrev">M6 6h2v12H6zm3.5 6l8.5 6V6z</Geometry>
            <Geometry x:Key="IconNext">M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z</Geometry>
            <Geometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 5L20.49 19l-5-5zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z</Geometry>
            <Geometry x:Key="IconClose">M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</Geometry>
            <Geometry x:Key="IconQueue">M4 6h16v2H4zm0 5h16v2H4zm0 5h10v2H4z</Geometry>
            <Geometry x:Key="IconSwap">M7 7h11l-3-3 1.41-1.41L21.83 8l-5.42 5.41L15 12l3-3H7zm10 10H6l3 3-1.41 1.41L2.17 16l5.42-5.41L9 12l-3 3h11z</Geometry>

            <!-- Pill button, matching .header-btn/.pill: transparent, bordered,
                 muted text that lights up gold on hover. -->
            <Style x:Key="PillButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="999" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Section-tag pills (Continue watching / Films / Series / ...): a
                 plain Button, not a RadioButton: these are built dynamically
                 in code (only tags for sections that actually have content
                 appear, same as railAnchors in main.go's frontend JS), and
                 "active" is which one was last scrolled past, not a mutually-
                 exclusive selection. Managing that by hand in code (see
                 SetActiveSectionTag in MainWindow.xaml.cs) sidesteps
                 RadioButton's own GroupName-based grouping entirely, which
                 this app already hit one hard-to-diagnose timing bug in
                 (see the Local/Online toggle's history). -->
            <Style x:Key="SectionTagButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Local/Online: a single alternating toggle (one Button whose
                 Content flips), not two mutually-exclusive pills. -->
            <Style x:Key="ToggleSwitchButton" TargetType="Button" BasedOn="{StaticResource PillButton}"/>

            <!-- Small circular overflow button in a card's corner, matching
                 .card-more on the web. -->
            <Style x:Key="CardMoreButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Background" Value="#B8000000"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Circular icon button for player controls (play/pause/back/etc). -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom title bar buttons (minimize/maximize/close); see
                 WindowChrome in MainWindow.xaml, which replaces the native
                 title bar (a plain OS-themed strip that clashed with the
                 dark app content below it) with this hand-drawn one. -->
            <Style x:Key="TitleBarButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Flat progress fill (no native Windows chrome), matching .pc-prog/i. -->
            <Style x:Key="FlatProgressBar" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                <Setter Property="Background" Value="#2EFFFFFF"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="3"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="1"/>
            </Style>

            <Style x:Key="DarkTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Poster/thumbnail card: art wall at rest, caption fades in on
                 hover (see the "Title on demand" comment on .pc-ovl in main.go,
                 the same "Letterboxd move" reproduced here via
                 DataTemplate.Triggers instead of a CSS :hover rule), a no-art
                 fallback tile for the portion of the library with no TMDB
                 match, and a thin gold progress sliver along the bottom edge.
                 Shared (not window-scoped) so the playlist detail window and
                 the queue drawer render identical cards. -->
            <DataTemplate x:Key="FileCardTemplate">
                <Grid x:Name="CardRoot" Width="150" Height="240" Margin="7">
                    <Border CornerRadius="6" Background="{StaticResource Bg3Brush}" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding CardImageUrl}">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Stretch" Value="UniformToFill"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CardImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <!-- No real 2:3 poster, only a 16:9 video
                                                 frame (see CardImageUrl's fallback to
                                                 ThumbUrl): crop-filling that into this
                                                 tall frame loses most of the picture,
                                                 which is what "wrong aspect ratio" for
                                                 non-movie entries turned out to mean.
                                                 Letterbox it instead. -->
                                            <DataTrigger Binding="{Binding PosterUrl}" Value="{x:Null}">
                                                <Setter Property="Stretch" Value="Uniform"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <!-- No-art fallback -->
                            <Border Background="{StaticResource Bg3Brush}" Padding="12,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CardImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DisplayTitle}" Foreground="{StaticResource TextBrush}"
                                           FontFamily="{StaticResource SerifFont}" FontWeight="Bold" FontSize="14"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Hover-reveal caption -->
                            <Border x:Name="Overlay" VerticalAlignment="Bottom" Opacity="0" Padding="9,8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#EB000000" Offset="0"/>
                                        <GradientStop Color="#73000000" Offset="0.38"/>
                                        <GradientStop Color="#00000000" Offset="0.68"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontSize="12"
                                               TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Foreground="{StaticResource GoldTextBrush}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Rating, StringFormat='★ {0:0.0}'}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rating}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <ProgressBar Style="{StaticResource FlatProgressBar}" VerticalAlignment="Bottom"
                                         Value="{Binding Progress, Mode=OneTime}"/>

                            <!-- Overflow menu (Queue/Playlist), matching .card-more
                                 on the web: a small hover-revealed button in the
                                 corner rather than a right-click menu anywhere on
                                 the card, which read as an unwanted "detail menu"
                                 popping up. Its Click is handled by bubbling up to
                                 the owning ListBox (see AttachCardMoreMenu in
                                 MainWindow.xaml.cs) rather than a named handler
                                 here, since this template is shared across windows
                                 with different code-behind. -->
                            <Button x:Name="CardMoreButton" Content="⋮" Style="{StaticResource CardMoreButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0"/>
                        </Grid>
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                        <Setter TargetName="CardMoreButton" Property="Opacity" Value="1"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="CardWrapPanel">
                <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>

            <Style x:Key="CardListBox" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ItemsPanel" Value="{StaticResource CardWrapPanel}"/>
                <Setter Property="ItemTemplate" Value="{StaticResource FileCardTemplate}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Padding" Value="8"/>
                <!-- Strip the default selection/focus chrome (a blue rectangle):
                     the card template's own hover-reveal caption already carries
                     all the visual state this wall needs. -->
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Same card list, but allowed its own vertical scrollbar, for
                 use inside a fixed-height container (the queue drawer, the
                 playlist detail window) rather than the main page's single
                 outer ScrollViewer. -->
            <Style x:Key="ScrollableCardListBox" TargetType="ListBox" BasedOn="{StaticResource CardListBox}">
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

            <!-- Wide 16:9 variant of FileCardTemplate for Continue
                 watching/Music videos/Library, matching the web UI's own
                 .cw-shot cards: these show an actual frame from the video
                 (ThumbnailImageUrl), not a 2:3 poster forced into the wrong
                 shape, which is what "wrong aspect ratio" turned out to mean
                 for anything that isn't a Film/Series poster. -->
            <DataTemplate x:Key="FileCardTemplateWide">
                <Grid x:Name="CardRoot" Width="266" Height="150" Margin="7">
                    <Border CornerRadius="6" Background="{StaticResource Bg3Brush}" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding ThumbnailImageUrl}" Stretch="UniformToFill">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThumbnailImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <Border Background="{StaticResource Bg3Brush}" Padding="12,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThumbnailImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DisplayTitle}" Foreground="{StaticResource TextBrush}"
                                           FontFamily="{StaticResource SerifFont}" FontWeight="Bold" FontSize="13"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Border>

                            <Border x:Name="Overlay" VerticalAlignment="Bottom" Opacity="0" Padding="9,7">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#EB000000" Offset="0"/>
                                        <GradientStop Color="#73000000" Offset="0.42"/>
                                        <GradientStop Color="#00000000" Offset="0.75"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontSize="11"
                                           TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <ProgressBar Style="{StaticResource FlatProgressBar}" VerticalAlignment="Bottom"
                                         Value="{Binding Progress, Mode=OneTime}"/>

                            <Button x:Name="CardMoreButton" Content="⋮" Style="{StaticResource CardMoreButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0"/>
                        </Grid>
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                        <Setter TargetName="CardMoreButton" Property="Opacity" Value="1"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="WideCardListBox" TargetType="ListBox" BasedOn="{StaticResource CardListBox}">
                <Setter Property="ItemTemplate" Value="{StaticResource FileCardTemplateWide}"/>
            </Style>

            <!-- Continue Watching's own card, matching .cw-shot/.cw-bar/
                 .cw-meta/.cw-t/.cw-s exactly: unlike FileCardTemplateWide
                 above, the caption sits permanently below the image (not a
                 hover-reveal overlay on top of it), with the progress bar
                 staying on the image itself. -->
            <DataTemplate x:Key="ContinueWatchingCardTemplate">
                <Grid x:Name="CardRoot" Width="266" Margin="7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="6" Background="{StaticResource Bg3Brush}" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding ThumbnailImageUrl}" Stretch="UniformToFill">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThumbnailImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <TextBlock Text="&#9654;" FontSize="22" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThumbnailImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ProgressBar Style="{StaticResource FlatProgressBar}" VerticalAlignment="Bottom"
                                         Value="{Binding Progress, Mode=OneTime}"/>

                            <Button x:Name="CardMoreButton" Content="⋮" Style="{StaticResource CardMoreButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ContinueWatchingLine}" Foreground="{StaticResource TextBrush}"
                                   FontFamily="{StaticResource SansFont}" FontSize="13" LineHeight="17"
                                   TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding RemainingLabel}" Foreground="{StaticResource MutedBrush}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="10.5" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                    <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                        <Setter TargetName="CardMoreButton" Property="Opacity" Value="1"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="ContinueWatchingCardListBox" TargetType="ListBox" BasedOn="{StaticResource CardListBox}">
                <Setter Property="ItemTemplate" Value="{StaticResource ContinueWatchingCardTemplate}"/>
            </Style>

            <!-- Solid-gold hero play/resume button, matching .hero-btn: a
                 filled pill (not the outlined PillButton the rest of the app
                 uses), dark text on gold, brightening slightly on hover. -->
            <Style x:Key="HeroPlayButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
                <Setter Property="Foreground" Value="#0A0A0A"/>
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="18,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Playlist tile for the Playlists section, 16:9-ish, matching
                 .pl-cover on the web (a wide cover rather than a poster's
                 2:3), since no cover-image binding is wired up yet this is
                 just a named tile; PlaylistDetailWindow opens on click. -->
            <DataTemplate x:Key="PlaylistCardTemplate">
                <Border Width="220" Height="140" Margin="7" CornerRadius="6" Cursor="Hand"
                        Background="{StaticResource Bg3Brush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                   FontFamily="{StaticResource SerifFont}" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="190"/>
                        <TextBlock Text="{Binding Items.Count, StringFormat='{}{0} items'}"
                                   Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <Style x:Key="PlaylistCardListBox" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ItemsPanel" Value="{StaticResource CardWrapPanel}"/>
                <Setter Property="ItemTemplate" Value="{StaticResource PlaylistCardTemplate}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
