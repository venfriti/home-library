<Application x:Class="StreamVideosPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette: mirrors the web UI's :root custom properties in main.go
                 (search for the "0a0a0a" background color there) so the native
                 app reads as the same product rather than a generic WPF app. -->
            <SolidColorBrush x:Key="BgBrush" Color="#0A0A0A"/>
            <SolidColorBrush x:Key="Bg2Brush" Color="#141414"/>
            <SolidColorBrush x:Key="Bg3Brush" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="BorderBrush2" Color="#2A2A2A"/>
            <SolidColorBrush x:Key="GoldBrush" Color="#9A7D4A"/>
            <SolidColorBrush x:Key="GoldTextBrush" Color="#C9A765"/>
            <SolidColorBrush x:Key="TextBrush" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#666666"/>
            <SolidColorBrush x:Key="PlayBrush" Color="#D9282D"/>
            <SolidColorBrush x:Key="PlayLitBrush" Color="#EF3237"/>

            <!-- Implicit (no x:Key) ScrollBar style: applies to every
                 scrollbar in the app automatically, replacing the default
                 light Windows chrome (which stood out badly against the dark
                 theme) with a thin, minimal thumb matching the palette. -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10"/>
                <Setter Property="MinWidth" Value="10"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Width="10">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                                      Background="Transparent" BorderThickness="0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                                      Background="Transparent" BorderThickness="0"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBd" Background="{StaticResource BorderBrush2}"
                                                            CornerRadius="4" Margin="2,0"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBd" Property="Background"
                                                                    Value="{StaticResource GoldBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark ContextMenu/MenuItem: the default is a light OS-themed
                 popup, which stood out the same way the scrollbar did. -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4"/>
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg3Brush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The site loads DM Sans / JetBrains Mono / Libre Baskerville from
                 Google Fonts. Those aren't installed system-wide on Windows, so
                 this uses the same fallback fonts the site's own CSS font-stack
                 names (Consolas for mono, Georgia for the serif no-art titles;
                 Segoe UI is Windows' own DM-Sans-equivalent geometric sans). -->
            <FontFamily x:Key="SansFont">Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">Consolas</FontFamily>
            <FontFamily x:Key="SerifFont">Georgia</FontFamily>

            <!-- Same Material-style icon paths the web UI's inline <svg> icons use
                 (see MINI_PLAY_ICON/MINI_PAUSE_ICON and #topbar-back in main.go). -->
            <Geometry x:Key="IconPlay">M8 5v14l11-7z</Geometry>
            <Geometry x:Key="IconPause">M6 19h4V5H6v14zm8-14v14h4V5h-4z</Geometry>
            <Geometry x:Key="IconBack">M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z</Geometry>
            <Geometry x:Key="IconPrev">M6 6h2v12H6zm3.5 6l8.5 6V6z</Geometry>
            <Geometry x:Key="IconNext">M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z</Geometry>
            <Geometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 5L20.49 19l-5-5zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z</Geometry>
            <Geometry x:Key="IconClose">M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</Geometry>
            <Geometry x:Key="IconQueue">M4 6h16v2H4zm0 5h16v2H4zm0 5h10v2H4z</Geometry>
            <Geometry x:Key="IconSwap">M7 7h11l-3-3 1.41-1.41L21.83 8l-5.42 5.41L15 12l3-3H7zm10 10H6l3 3-1.41 1.41L2.17 16l5.42-5.41L9 12l-3 3h11z</Geometry>

            <!-- Pill button, matching .header-btn/.pill: transparent, bordered,
                 muted text that lights up gold on hover. -->
            <Style x:Key="PillButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="999" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Section-tag pills (Continue watching / Films / Series / ...): a
                 plain Button, not a RadioButton: these are built dynamically
                 in code (only tags for sections that actually have content
                 appear, same as railAnchors in main.go's frontend JS), and
                 "active" is which one was last scrolled past, not a mutually-
                 exclusive selection. Managing that by hand in code (see
                 SetActiveSectionTag in MainWindow.xaml.cs) sidesteps
                 RadioButton's own GroupName-based grouping entirely, which
                 this app already hit one hard-to-diagnose timing bug in
                 (see the Local/Online toggle's history). -->
            <Style x:Key="SectionTagButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Local/Online: a single alternating toggle (one Button whose
                 Content flips), not two mutually-exclusive pills. -->
            <Style x:Key="ToggleSwitchButton" TargetType="Button" BasedOn="{StaticResource PillButton}"/>

            <!-- Small circular overflow button in a card's corner, matching
                 .card-more on the web. -->
            <Style x:Key="CardMoreButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Background" Value="#B8000000"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Circular icon button for player controls (play/pause/back/etc). -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom title bar buttons (minimize/maximize/close); see
                 WindowChrome in MainWindow.xaml, which replaces the native
                 title bar (a plain OS-themed strip that clashed with the
                 dark app content below it) with this hand-drawn one. -->
            <Style x:Key="TitleBarButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Flat progress fill (no native Windows chrome), matching .pc-prog/i. -->
            <Style x:Key="FlatProgressBar" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                <Setter Property="Background" Value="#2EFFFFFF"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="3"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="1"/>
            </Style>

            <Style x:Key="DarkTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Poster/thumbnail card: art wall at rest, caption fades in on
                 hover (see the "Title on demand" comment on .pc-ovl in main.go,
                 the same "Letterboxd move" reproduced here via
                 DataTemplate.Triggers instead of a CSS :hover rule), a no-art
                 fallback tile for the portion of the library with no TMDB
                 match, and a thin gold progress sliver along the bottom edge.
                 Shared (not window-scoped) so the playlist detail window and
                 the queue drawer render identical cards. -->
            <DataTemplate x:Key="FileCardTemplate">
                <!-- Matches #file-grid/#other-grid's real geometry: a fixed
                     5-column grid at the site's 980px shell width, 18px gap:
                     169x254 (2:3) with a 9px margin (half the 18px gap on
                     each side) is that grid's actual per-card size, not an
                     arbitrary pick. Same card/grid the web uses for Library
                     ("Other" there), not a wide one: see AddFileSection. -->
                <Grid x:Name="CardRoot" Width="169" Height="254" Margin="9">
                    <Border CornerRadius="6" Background="{StaticResource Bg3Brush}" ClipToBounds="True">
                        <Grid>
                            <!-- Hover zoom, matching .pc-cover img's own
                                 transform:scale(1.045) (see .card:hover
                                 .pc-cover img in main.go). The CSS
                                 filter:brightness(1.1) alongside it has no
                                 direct WPF equivalent without a pixel shader;
                                 BrightnessWash below (a low-opacity white
                                 wash faded in on the same trigger) is a
                                 cheap, close-enough approximation. -->
                            <Image x:Name="CoverImage" Source="{Binding CardImageUrl}" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Image.RenderTransform>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Stretch" Value="UniformToFill"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CardImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <!-- No real 2:3 poster, only a 16:9 video
                                                 frame (see CardImageUrl's fallback to
                                                 ThumbUrl): crop-filling that into this
                                                 tall frame loses most of the picture,
                                                 which is what "wrong aspect ratio" for
                                                 non-movie entries turned out to mean.
                                                 Letterbox it instead. -->
                                            <DataTrigger Binding="{Binding PosterUrl}" Value="{x:Null}">
                                                <Setter Property="Stretch" Value="Uniform"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProcState}" Value="processing">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProcState}" Value="error">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Border x:Name="BrightnessWash" Background="White" Opacity="0" IsHitTestVisible="False"/>

                            <!-- Processing/error state, matching .pc-proc:
                                 a spinner glyph while a file is still being
                                 transcoded/probed, or a red-tinted ✕ if that
                                 failed. Takes over the whole cover either
                                 way, same as the site. -->
                            <Border x:Name="ProcOverlay" Visibility="Collapsed">
                                <TextBlock FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#9696;"/>
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProcState}" Value="error">
                                                    <Setter Property="Text" Value="&#10005;"/>
                                                    <Setter Property="Foreground" Value="#E06C6C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProcState}" Value="processing">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProcState}" Value="error">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Background" Value="#B85A1414"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- No-art fallback -->
                            <Border Background="{StaticResource Bg3Brush}" Padding="12,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CardImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DisplayTitle}" Foreground="{StaticResource TextBrush}"
                                           FontFamily="{StaticResource SerifFont}" FontWeight="Bold" FontSize="14"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Hover-reveal caption -->
                            <Border x:Name="Overlay" VerticalAlignment="Bottom" Opacity="0" Padding="9,8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#EB000000" Offset="0"/>
                                        <GradientStop Color="#73000000" Offset="0.38"/>
                                        <GradientStop Color="#00000000" Offset="0.68"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontSize="12"
                                               TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Foreground="{StaticResource GoldTextBrush}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Rating, StringFormat='★ {0:0.0}'}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rating}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <ProgressBar Style="{StaticResource FlatProgressBar}" VerticalAlignment="Bottom"
                                         Value="{Binding Progress, Mode=OneTime}"/>

                            <!-- Overflow menu (Queue/Playlist), matching .card-more
                                 on the web: a small hover-revealed button in the
                                 corner rather than a right-click menu anywhere on
                                 the card, which read as an unwanted "detail menu"
                                 popping up. Its Click is handled by bubbling up to
                                 the owning ListBox (see AttachCardMoreMenu in
                                 MainWindow.xaml.cs) rather than a named handler
                                 here, since this template is shared across windows
                                 with different code-behind. -->
                            <Button x:Name="CardMoreButton" Content="⋮" Style="{StaticResource CardMoreButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0"/>
                        </Grid>
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                        <Setter TargetName="CardMoreButton" Property="Opacity" Value="1"/>
                        <Setter TargetName="CoverImage" Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1.045" ScaleY="1.045"/>
                            </Setter.Value>
                        </Setter>
                        <Setter TargetName="BrightnessWash" Property="Opacity" Value="0.08"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="CardWrapPanel">
                <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>

            <Style x:Key="CardListBox" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ItemsPanel" Value="{StaticResource CardWrapPanel}"/>
                <Setter Property="ItemTemplate" Value="{StaticResource FileCardTemplate}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Padding" Value="8"/>
                <!-- Strip the default selection/focus chrome (a blue rectangle):
                     the card template's own hover-reveal caption already carries
                     all the visual state this wall needs. -->
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Same card list, but allowed its own vertical scrollbar, for
                 use inside a fixed-height container (the queue drawer, the
                 playlist detail window) rather than the main page's single
                 outer ScrollViewer. -->
            <Style x:Key="ScrollableCardListBox" TargetType="ListBox" BasedOn="{StaticResource CardListBox}">
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

            <!-- Show tile for the Series rail, matching renderShowCard
                 exactly: a near-copy of FileCardTemplate above (same 2:3
                 poster shape, same hover-reveal caption), but the caption's
                 second line is "{count} episodes"/"{n} seasons" (see
                 seriesCount in main.go), not a star rating: a show has no
                 single rating of its own, and there's no overflow button
                 (renderShowCard has no cardMoreHTML() call either; queueing/
                 playlisting only makes sense for one playable episode, not
                 a whole show). Bound to ShowGroup, one per unique tmdb_id,
                 not one card per episode. -->
            <DataTemplate x:Key="ShowCardTemplate">
                <Grid x:Name="CardRoot" Width="169" Height="254" Margin="9">
                    <Border CornerRadius="6" Background="{StaticResource Bg3Brush}" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="CoverImage" Source="{Binding CardImageUrl}" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Image.RenderTransform>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Stretch" Value="UniformToFill"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CardImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PosterUrl}" Value="{x:Null}">
                                                <Setter Property="Stretch" Value="Uniform"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Border x:Name="BrightnessWash" Background="White" Opacity="0" IsHitTestVisible="False"/>

                            <Border Background="{StaticResource Bg3Brush}" Padding="12,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CardImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DisplayTitle}" Foreground="{StaticResource TextBrush}"
                                           FontFamily="{StaticResource SerifFont}" FontWeight="Bold" FontSize="14"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Border>

                            <Border x:Name="Overlay" VerticalAlignment="Bottom" Opacity="0" Padding="9,8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#EB000000" Offset="0"/>
                                        <GradientStop Color="#73000000" Offset="0.38"/>
                                        <GradientStop Color="#00000000" Offset="0.68"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontSize="12"
                                               TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CountLabel}" Foreground="{StaticResource GoldTextBrush}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <ProgressBar Style="{StaticResource FlatProgressBar}" VerticalAlignment="Bottom"
                                         Value="{Binding Progress, Mode=OneTime}"/>
                        </Grid>
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                        <Setter TargetName="CoverImage" Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1.045" ScaleY="1.045"/>
                            </Setter.Value>
                        </Setter>
                        <Setter TargetName="BrightnessWash" Property="Opacity" Value="0.08"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="ShowCardListBox" TargetType="ListBox" BasedOn="{StaticResource CardListBox}">
                <Setter Property="ItemTemplate" Value="{StaticResource ShowCardTemplate}"/>
            </Style>

            <!-- Continue Watching's own card, matching .cw-shot/.cw-bar/
                 .cw-meta/.cw-t/.cw-s exactly: the caption sits permanently
                 below the image (not a hover-reveal overlay on top of it),
                 with the progress bar staying on the image itself. Sized to
                 match .cw-rail's real geometry: repeat(auto-fill,minmax
                 (230px,1fr)) at the site's 980px shell settles on 3 columns
                 of ~295px each with a 16px gap (8px margin per side), not
                 an arbitrary width. Playlists reuse this same grid+size on
                 the web (.cw-rail is literally what wallEls.plRail is), so
                 PlaylistCardListBox below is built to match, not coincidence. -->
            <DataTemplate x:Key="ContinueWatchingCardTemplate">
                <Grid x:Name="CardRoot" Width="295" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="166"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="6" Background="{StaticResource Bg3Brush}" ClipToBounds="True">
                        <Grid>
                            <!-- Hover zoom, matching .cw-shot img's
                                 transform:scale(1.04); BrightnessWash
                                 approximates the accompanying
                                 filter:brightness(1.1), see FileCardTemplate. -->
                            <Image x:Name="CoverImage" Source="{Binding ThumbnailImageUrl}" Stretch="UniformToFill"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Image.RenderTransform>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThumbnailImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Border x:Name="BrightnessWash" Background="White" Opacity="0" IsHitTestVisible="False"/>

                            <TextBlock Text="&#9654;" FontSize="22" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThumbnailImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Processing/error state, matching .pc-proc: see FileCardTemplate. -->
                            <Border x:Name="ProcOverlay" Visibility="Collapsed">
                                <TextBlock FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#9696;"/>
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProcState}" Value="error">
                                                    <Setter Property="Text" Value="&#10005;"/>
                                                    <Setter Property="Foreground" Value="#E06C6C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProcState}" Value="processing">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProcState}" Value="error">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Background" Value="#B85A1414"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <ProgressBar Style="{StaticResource FlatProgressBar}" VerticalAlignment="Bottom"
                                         Value="{Binding Progress, Mode=OneTime}"/>

                            <Button x:Name="CardMoreButton" Content="⋮" Style="{StaticResource CardMoreButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ContinueWatchingLine}" Foreground="{StaticResource TextBrush}"
                                   FontFamily="{StaticResource SansFont}" FontSize="13" LineHeight="17"
                                   TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding RemainingLabel}" Foreground="{StaticResource MutedBrush}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="10.5" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                    <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                        <Setter TargetName="CardMoreButton" Property="Opacity" Value="1"/>
                        <Setter TargetName="CoverImage" Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                            </Setter.Value>
                        </Setter>
                        <Setter TargetName="BrightnessWash" Property="Opacity" Value="0.08"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="ContinueWatchingCardListBox" TargetType="ListBox" BasedOn="{StaticResource CardListBox}">
                <Setter Property="ItemTemplate" Value="{StaticResource ContinueWatchingCardTemplate}"/>
            </Style>

            <!-- Solid-gold hero play/resume button, matching .hero-btn: a
                 filled pill (not the outlined PillButton the rest of the app
                 uses), dark text on gold, brightening slightly on hover. -->
            <Style x:Key="HeroPlayButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
                <Setter Property="Foreground" Value="#0A0A0A"/>
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="18,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Music video card, matching .mv2-card/.mv2-cover/.pc-info/
                 .pc-title/.pc-year exactly: a 16:9 still with a PERMANENT
                 caption below it (title + artist), not the hover-reveal
                 overlay Films/Series use, and no progress bar (music videos
                 aren't part of Continue Watching). Sized to #music-grid's
                 real geometry: repeat(auto-fill,minmax(215px,1fr)) at the
                 980px shell settles on 3 columns of ~289px, gap 24px
                 horizontal / 28px vertical: an asymmetric margin
                 (12 L/R, 14 T/B) reproduces that row-gap-vs-column-gap
                 split, which a single uniform gap number can't. -->
            <DataTemplate x:Key="MusicVideoCardTemplate">
                <Grid x:Name="CardRoot" Width="289" Margin="12,14,12,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="163"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="6" Background="{StaticResource Bg3Brush}" ClipToBounds="True">
                        <Grid>
                            <!-- Hover zoom, matching .mv2-cover img's
                                 transform:scale(1.045); BrightnessWash
                                 approximates its filter:brightness(1.18). -->
                            <Image x:Name="CoverImage" Source="{Binding ThumbnailImageUrl}" Stretch="UniformToFill"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Image.RenderTransform>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThumbnailImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Border x:Name="BrightnessWash" Background="White" Opacity="0" IsHitTestVisible="False"/>

                            <TextBlock Text="&#9834;" FontSize="22" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThumbnailImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Processing/error state, matching .pc-proc: see FileCardTemplate. -->
                            <Border x:Name="ProcOverlay" Visibility="Collapsed">
                                <TextBlock FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#9696;"/>
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProcState}" Value="error">
                                                    <Setter Property="Text" Value="&#10005;"/>
                                                    <Setter Property="Foreground" Value="#E06C6C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProcState}" Value="processing">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProcState}" Value="error">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Background" Value="#B85A1414"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <Button x:Name="CardMoreButton" Content="⋮" Style="{StaticResource CardMoreButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="{Binding DisplayTitle}" Foreground="#D0D0D0"
                                   FontFamily="{StaticResource SansFont}" FontSize="12" LineHeight="16"
                                   TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Foreground="#686868" FontFamily="{StaticResource SansFont}" FontSize="10"
                                   Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Artist}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Artist}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                    <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                        <Setter TargetName="CardMoreButton" Property="Opacity" Value="1"/>
                        <Setter TargetName="CoverImage" Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1.045" ScaleY="1.045"/>
                            </Setter.Value>
                        </Setter>
                        <Setter TargetName="BrightnessWash" Property="Opacity" Value="0.1"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="MusicVideoCardListBox" TargetType="ListBox" BasedOn="{StaticResource CardListBox}">
                <Setter Property="ItemTemplate" Value="{StaticResource MusicVideoCardTemplate}"/>
            </Style>

            <!-- Playlist tile, matching .pl-card/.pl-cover/.pl-play/.pl-meta/
                 .pl-name/.pl-count exactly: the server-composed cover image
                 (CoverImage, fetched via GetPlaylistCoverAsync since an Image
                 bound straight to the /playlists/cover URL can't carry the
                 session cookie that route requires), a circular play button
                 that fades in on hover, and a permanent title+count caption
                 below the cover. main.go's own plRail is literally a
                 .cw-rail (see wallEls.plRail), so this reuses
                 ContinueWatchingCardTemplate's exact sizing, not a
                 coincidence. -->
            <DataTemplate x:Key="PlaylistCardTemplate">
                <Grid x:Name="CardRoot" Width="295" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="166"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Hover glow, matching .pl-card:hover .pl-cover's
                         box-shadow:0 0 16px 1px rgba(255,255,255,.22): a
                         glow rather than the zoom the other card types get,
                         since .pl-cover has no img:hover transform rule. -->
                    <Border x:Name="CoverBorder" Grid.Row="0" CornerRadius="6" Background="{StaticResource Bg3Brush}" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CoverImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <!-- .pl-empty: no cover to compose (an empty
                                 playlist) or the fetch failed. -->
                            <TextBlock Text="&#9834;" FontSize="24" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CoverImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button x:Name="PlayButton" Content="&#9654;" Width="34" Height="34" Opacity="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"
                                    Background="{StaticResource PlayBrush}" Foreground="White" BorderThickness="0"
                                    FontSize="12" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="999">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource PlayLitBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CoverImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                   FontFamily="{StaticResource SansFont}" FontSize="13" LineHeight="17"
                                   TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="10.5" Margin="0,3,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Items.Count, StringFormat='{}{0} items'}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count}" Value="1">
                                            <Setter Property="Text" Value="1 item"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                    <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                        <Setter TargetName="PlayButton" Property="Opacity" Value="1"/>
                        <Setter TargetName="CoverBorder" Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="White" BlurRadius="16" ShadowDepth="0" Opacity="0.55"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="PlaylistCardListBox" TargetType="ListBox" BasedOn="{StaticResource CardListBox}">
                <Setter Property="ItemTemplate" Value="{StaticResource PlaylistCardTemplate}"/>
            </Style>

            <!-- Episode row for ShowDetailWindow (FilmDetailWindow's own
                 Extras list reuses ContinueWatchingCardTemplate instead,
                 since extras are single playable clips, not a numbered
                 episode sequence with its own overview text the way
                 episodes are). Matches .sv-ep-row/.sv-ep-shot/.sv-ep-info/
                 .sv-ep-head/.sv-ep-name/.sv-ep-time/.sv-ep-desc: number,
                 still with its own progress sliver, title + duration,
                 overview, as a vertical list rather than a wrapping card
                 wall. -->
            <DataTemplate x:Key="EpisodeRowTemplate">
                <Grid Margin="0,0,0,14" Cursor="Hand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Episode}" Foreground="{StaticResource MutedBrush}"
                               FontFamily="{StaticResource MonoFont}" FontSize="13" VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <Border Grid.Column="1" Height="90" CornerRadius="4" Background="{StaticResource Bg3Brush}"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding ThumbnailImageUrl}" Stretch="UniformToFill">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThumbnailImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Text="&#9654;" FontSize="18" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThumbnailImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ProgressBar Style="{StaticResource FlatProgressBar}" VerticalAlignment="Bottom"
                                         Value="{Binding Progress, Mode=OneTime}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DurationLabel}"
                                       Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="11" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding EpisodeRowTitle}" Foreground="{StaticResource TextBrush}"
                                       FontFamily="{StaticResource SansFont}" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding EpisodeOverview}" Foreground="{StaticResource MutedBrush}"
                                   FontFamily="{StaticResource SansFont}" FontSize="11.5" LineHeight="16"
                                   TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EpisodeOverview}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <Style x:Key="EpisodeRowListBox" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ItemTemplate" Value="{StaticResource EpisodeRowTemplate}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Season tab pill, matching .sv-season-tab/.active. -->
            <Style x:Key="SeasonTabButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="999"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Active">
                        <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
                        <Setter Property="Foreground" Value="#0A0A0A"/>
                        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
